# ---------------------------------------------------------------- segredos
# appsettings.Development.json É versionado: guarda configuração local sem
# segredo (portas, origens de CORS). Segredo em .NET vai para
# `dotnet user-secrets`, que grava fora do repositório.
.env
.env.local
.env*.local

# ---------------------------------------------------------------- gerado
# O cliente TypeScript É versionado, apesar de gerado.
#
# A razão é o build isolado: no PaaS, cada serviço constrói só a sua pasta, e
# de dentro de web/ o arquivo api/openapi.json não existe. Gerar no build
# deixou de ser possível.
#
# A divergência que "não versionar" evitava continua guardada: a integração
# contínua regera do código da API e falha se este arquivo ou o openapi.json
# estiverem desatualizados.

# ---------------------------------------------------------------- sistema
Thumbs.db
.DS_Store
